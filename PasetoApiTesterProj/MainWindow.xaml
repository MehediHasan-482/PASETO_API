<Window x:Class="PasetoApiTesterProj.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasetoApiTesterProj"
        mc:Ignorable="d"
        Title="PASETO API Tester"
        Width="900" Height="680"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

  
        <Border Grid.Row="0" Background="#5B4FD9">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PASETO" FontSize="16" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" API Tester" FontSize="16"
                               Foreground="#C8C4F8" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="TokenDot" Width="8" Height="8" Fill="#5DCAA5" Margin="0,0,6,0"/>
                    <TextBlock x:Name="UserLabel" Text="Authenticated"
                               Foreground="#C8C4F8" FontSize="12"/>
                    <Button x:Name="LogoutBtn" Content="Logout"
                            Margin="12,0,0,0" Padding="10,4" FontSize="11"
                            Click="LogoutBtn_Click"
                            Foreground="White" Background="Transparent"
                            BorderBrush="#8880E8" BorderThickness="1" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#6B5FE0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Endpoints -->
            <Border Grid.Column="0" BorderBrush="#E8E8E4" BorderThickness="0,0,1,0" Background="#FAFAF8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">

                        <TextBlock Text="Endpoints" FontSize="11" FontWeight="Bold"
                                   Foreground="#8880D0" Margin="0,16,0,12"/>

                        <!-- /api/users/me -->
                        <Border Background="White" BorderBrush="#E8E8E4" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Background="#E1F5EE" CornerRadius="4" Padding="5,2">
                                        <TextBlock Text="GET" FontSize="10" FontWeight="Bold" Foreground="#0F6E56"/>
                                    </Border>
                                    <TextBlock Text="/api/users/me" FontSize="12" Foreground="#2C2C2A"
                                               Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                                </StackPanel>
                                <TextBlock Text="Returns the current authenticated user's info."
                                           FontSize="11" Foreground="#6B6B67" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <Button Content="Send Request" Style="{StaticResource SuccessButton}"
                                        Padding="10,6" FontSize="11" Click="MeBtn_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- /api/users/admin-only -->
                        <Border Background="White" BorderBrush="#E8E8E4" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Background="#E1F5EE" CornerRadius="4" Padding="5,2">
                                        <TextBlock Text="GET" FontSize="10" FontWeight="Bold" Foreground="#0F6E56"/>
                                    </Border>
                                    <TextBlock Text="/api/users/admin-only" FontSize="12" Foreground="#2C2C2A"
                                               Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                                </StackPanel>
                                <TextBlock Text="Accessible only by Admin role."
                                           FontSize="11" Foreground="#6B6B67" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <Button Content="Send Request" Style="{StaticResource DangerButton}"
                                        Padding="10,6" FontSize="11" Click="AdminBtn_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- /api/users/manager-or-admin -->
                        <Border Background="White" BorderBrush="#E8E8E4" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Background="#E1F5EE" CornerRadius="4" Padding="5,2">
                                        <TextBlock Text="GET" FontSize="10" FontWeight="Bold" Foreground="#0F6E56"/>
                                    </Border>
                                    <TextBlock Text="/api/users/manager-or-admin" FontSize="11" Foreground="#2C2C2A"
                                               Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                                </StackPanel>
                                <TextBlock Text="Accessible by Manager or Admin roles."
                                           FontSize="11" Foreground="#6B6B67" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <Button Content="Send Request" Style="{StaticResource WarningButton}"
                                        Padding="10,6" FontSize="11" Click="ManagerBtn_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- /health -->
                        <Border Background="White" BorderBrush="#E8E8E4" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Background="#E1F5EE" CornerRadius="4" Padding="5,2">
                                        <TextBlock Text="GET" FontSize="10" FontWeight="Bold" Foreground="#0F6E56"/>
                                    </Border>
                                    <TextBlock Text="/health" FontSize="12" Foreground="#2C2C2A"
                                               Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                                </StackPanel>
                                <TextBlock Text="Public health check — no auth required."
                                           FontSize="11" Foreground="#6B6B67" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <Button Content="Send Request" Style="{StaticResource OutlineButton}"
                                        Padding="10,6" FontSize="11" Click="HealthBtn_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- /api/users/create-profile -->
                        <Border Background="White" BorderBrush="#E8E8E4" BorderThickness="1"
        CornerRadius="8" Padding="12" Margin="0,0,0,8">

                            <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">

                                    <Border Background="#EAF1FF" CornerRadius="4" Padding="5,2">
                                        <TextBlock Text="POST"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#2D5BFF"/>
                                    </Border>

                                    <TextBlock Text="/api/users/create-profile"
                       FontSize="12"
                       Foreground="#2C2C2A"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontFamily="Consolas"/>
                                </StackPanel>

                                <TextBlock Text="Create a new user profile (requires authentication)."
                   FontSize="11"
                   Foreground="#6B6B67"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap"/>

                                <Button Content="Send Request"
                Style="{StaticResource SuccessButton}"
                Padding="10,6"
                FontSize="11"
                Click="CreateProfileBtn_Click"/>

                            </StackPanel>
                        </Border>

                        <!-- Token Preview -->
                        <TextBlock Text="Current Token" FontSize="11" FontWeight="Bold"
                                   Foreground="#8880D0" Margin="0,8,0,8"/>
                        <Border Background="White" BorderBrush="#E8E8E4" BorderThickness="1"
                                CornerRadius="8" Padding="10">
                            <TextBox x:Name="TokenPreviewBox"
                                     FontFamily="Consolas" FontSize="10" Foreground="#5B4FD9"
                                     Background="Transparent" BorderThickness="0"
                                     IsReadOnly="True" TextWrapping="Wrap"/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel: Response -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Request Info -->
                <Border Grid.Row="0" Background="#F3F2FD" BorderBrush="#E8E8E4"
                        BorderThickness="0,0,0,1" Padding="20,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Last request:" FontSize="12" Foreground="#6B6B67" Margin="0,0,8,0"/>
                        <TextBlock x:Name="LastRequestLabel" Text="—" FontSize="12"
                                   Foreground="#5B4FD9" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

                <!-- Status -->
                <Border Grid.Row="1" Background="#F8F8F8" BorderBrush="#E8E8E4"
                        BorderThickness="0,0,0,1" Padding="20,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Status:" FontSize="12" Foreground="#6B6B67" Margin="0,0,8,0"/>
                        <Border x:Name="StatusBadge" CornerRadius="4" Padding="8,2" Background="#E1F5EE">
                            <TextBlock x:Name="StatusCodeLabel" Text="—" FontSize="12"
                                       FontWeight="Bold" Foreground="#0F6E56"/>
                        </Border>
                        <TextBlock Text="  |  " FontSize="12" Foreground="#C0C0BC"/>
                        <TextBlock Text="Time:" FontSize="12" Foreground="#6B6B67" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ResponseTimeLabel" Text="—" FontSize="12" Foreground="#2C2C2A"/>
                    </StackPanel>
                </Border>

                <!-- Response Body -->
                <Grid Grid.Row="2" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Response" FontSize="13" FontWeight="Bold"
                                   Foreground="#2C2C2A" VerticalAlignment="Center"/>
                        <Button Content="Copy" Margin="12,0,0,0"
                                Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="11"
                                Click="CopyBtn_Click"/>
                        <Button Content="Clear" Margin="8,0,0,0"
                                Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="11"
                                Click="ClearBtn_Click"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#1E1E2E" CornerRadius="10"
                            BorderBrush="#2E2E42" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto" Margin="4">
                            <TextBox x:Name="ResponseBox"
                                     Background="Transparent" Foreground="#CDD6F4"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="13" BorderThickness="0" IsReadOnly="True"
                                     TextWrapping="Wrap" AcceptsReturn="True" Padding="12"
                                     Text="Loading…"
                                     CaretBrush="Transparent"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>