<Window x:Class="PasetoApiTesterProj.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PASETO — Login"
        Width="420" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <Border Grid.Row="0" Background="#5B4FD9">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="PASETO" FontSize="28" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="API Tester" FontSize="14" Foreground="#C8C4F8"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <!-- Form -->
        <StackPanel Grid.Row="1" Margin="36,32,36,0">
            <TextBlock Text="Base URL" FontSize="12" Foreground="#6B6B67" Margin="0,0,0,4"/>
            <TextBox x:Name="BaseUrlBox"
                     Style="{StaticResource ModernTextBox}"
                     Text="http://localhost:5019"
                     Margin="0,0,0,16"/>
            <TextBlock Text="Username" FontSize="12" Foreground="#6B6B67" Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameBox"
                     Style="{StaticResource ModernTextBox}"
                     Margin="0,0,0,16"/>
            <TextBlock Text="Password" FontSize="12" Foreground="#6B6B67" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox"
                         Style="{StaticResource ModernPasswordBox}"
                         Margin="0,0,0,8"/>
            <!-- Error message -->
            <TextBlock x:Name="ErrorLabel" Text="" Foreground="#A32D2D"
                       FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <Button x:Name="LoginBtn" Content="Login"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch"
                    Click="LoginBtn_Click" Margin="0,8,0,20"/>
            <Separator Background="#E8E8E4" Margin="0,0,0,16"/>
            <TextBlock Text="Quick fill" FontSize="11" Foreground="#9B9B97" Margin="0,0,0,8"/>
            <WrapPanel x:Name="QuickFillPanel"/>
        </StackPanel>
    </Grid>
</Window>